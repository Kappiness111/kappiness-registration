# ---------------------------------------------------------------
# PUBLIC values only. Everything prefixed VITE_ is bundled into the
# browser code and visible to anyone. NEVER put the service_role /
# secret key here. Server secrets are set with `supabase secrets set`
# (see README → "Edge Function secrets").
# ---------------------------------------------------------------

# Supabase → Project Settings → API (Data API / API Keys)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older projects: you may use the legacy anon key instead
# VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Leave empty to disable CAPTCHA locally.
VITE_TURNSTILE_SITE_KEY=
